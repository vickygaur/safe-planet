DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve the Vite source index.html from Apache
  RewriteRule ^index\.html$ index.php [L]

  RewriteRule ^api/ - [L]
  RewriteRule ^admin/ - [L]

  # Built JS/CSS
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # Site photos from public/images → dist/images after build
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^images/(.*)$ dist/images/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^favicon\.png$ dist/favicon.png [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^logo\.png$ dist/logo.png [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^favicon\.svg$ dist/favicon.svg [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>
